{
  "name": "hyperframeui",
  "version": "0.0.0",
  "private": true,
  "description": "Local desktop workbench for Hyperframes — human + Claude agent co-edit videos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xwinnie/hyperframeUI.git"
  },
  "homepage": "https://github.com/0xwinnie/hyperframeUI",
  "bugs": "https://github.com/0xwinnie/hyperframeUI/issues",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @hyperframeui/desktop dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @hyperframeui/desktop build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
