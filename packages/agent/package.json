    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo '(lint not configured yet)'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.111",
    "@hyperframeui/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
